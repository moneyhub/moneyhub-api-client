#!/usr/bin/env sh
# Node versions to run tests on (aligned with engines ">= 20.20.0" and common LTS)
NODE_VERSIONS="20 22 24 26"

npm run lint
npm run build

# Load nvm when available so we can run tests on multiple Node versions in parallel
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"

  AVAILABLE=""
  for ver in $NODE_VERSIONS; do
    if nvm which "$ver" >/dev/null 2>&1; then
      AVAILABLE="$AVAILABLE $ver"
    else
      echo "Skipping Node $ver (not installed)"
    fi
  done
  # trim leading space
  AVAILABLE=$(echo "$AVAILABLE" | sed 's/^ *//')

  if [ -z "$AVAILABLE" ]; then
    echo "None of Node $NODE_VERSIONS installed; running tests with current Node only"
    npm test || exit 1
  else
    TMPD=$(mktemp -d)
    trap 'rm -rf "$TMPD"' EXIT
    PIDS=""
    for ver in $AVAILABLE; do
      nvm exec "$ver" npm test > "$TMPD/$ver" 2>&1 &
      PIDS="$PIDS $!"
    done
    FAIL=0
    set -- $PIDS
    for ver in $AVAILABLE; do
      r=0; wait "$1" || r=$?
      if [ $r -ne 0 ]; then
        FAIL=1
        echo "Node $ver failed:"
        cat "$TMPD/$ver" 2>/dev/null || true
      fi
      shift
    done
    if [ $FAIL -eq 0 ]; then
      echo "Tests passed on Node $AVAILABLE"
    else
      exit 1
    fi
  fi
else
  echo "nvm not found; running tests with current Node only"
  npm test || exit 1
fi

npm run test-caas
